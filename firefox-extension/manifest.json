{
  "manifest_version": 2,
  "name": "AI Agent Firefox Bridge & Sidebar",
  "version": "1.1.0",
  "description": "Bridges local Firefox with AI Browser Agent with a docked side panel to automate browsing directly on your machine with your active logins.",
  "permissions": [
    "tabs",
    "activeTab",
    "<all_urls>",
    "storage",
    "webNavigation",
    "webRequest",
    "webRequestBlocking"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "browser_action": {
    "default_icon": "icons/icon-48.png",
    "default_title": "AI Agent Assistant (Click to Toggle Sidebar)"
  },
  "sidebar_action": {
    "default_title": "AI Agent Assistant",
    "default_panel": "sidebar.html",
    "default_icon": "icons/icon-48.png",
    "open_at_install": true
  },
  "commands": {
    "_execute_sidebar_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "linux": "Ctrl+Shift+Y"
      },
      "description": "Toggle AI Agent Sidebar"
    }
  },
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png"
  }
}
